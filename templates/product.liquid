<section class="product-page">
  <div class="product-inner">

    <!-- Gallery -->
    <div class="product-gallery">
      {%- for image in product.images -%}
        <img
          src="{{ image | image_url: width: 1600 }}"
          alt="{{ image.alt | default: product.title | escape }}"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          width="{{ image.width }}"
          height="{{ image.height }}"
        >
      {%- endfor -%}
    </div>

    <!-- Info -->
    <div class="product-info">
      {%- assign year = product.metafields.custom.year | default: '2026' -%}
      {%- assign medium = product.metafields.custom.medium | default: 'Acrylic on Canvas' -%}
      {%- assign dims = product.metafields.custom.dimensions_cm | default: product.metafields.custom.dimensions -%}

      {%- if dims == blank -%}
        {%- assign t = product.title | downcase -%}
        {%- case t -%}
          {%- when '3 gooses' -%}{%- assign dims = '100 × 120 cm' -%}
          {%- when 'blue lover' -%}{%- assign dims = '80 × 120 cm' -%}
          {%- when 'eternity love' -%}{%- assign dims = '120 × 120 cm' -%}
          {%- when 'life choice' -%}{%- assign dims = '120 × 120 cm' -%}
          {%- when 'naked silence' -%}{%- assign dims = '120 × 120 cm' -%}
          {%- when 'seven men' -%}{%- assign dims = '120 × 80 cm' -%}
          {%- when 'st. tropez sunset' -%}{%- assign dims = '120 × 120 cm' -%}
          {%- when 'st tropez sunset' -%}{%- assign dims = '120 × 120 cm' -%}
          {%- when 'the architecture of desire' -%}{%- assign dims = '120 × 120 cm' -%}
          {%- when 'the curled' -%}{%- assign dims = '50 × 70 cm' -%}
          {%- when 'the landlord' -%}{%- assign dims = '150 × 100 cm' -%}
          {%- when 'the leopard' -%}{%- assign dims = '100 × 100 cm' -%}
          {%- when 'the masked' -%}{%- assign dims = '50 × 70 cm' -%}
          {%- when 'the privilege of being alone' -%}{%- assign dims = '100 × 120 cm' -%}
          {%- when 'the two blue' -%}{%- assign dims = '100 × 100 cm' -%}
          {%- when 'the western' -%}{%- assign dims = '120 × 80 cm' -%}
          {%- when 'world conspiracy' -%}{%- assign dims = '100 × 100 cm' -%}
        {%- endcase -%}
      {%- endif -%}

      <p class="product-year">{{ year }}</p>
      <h1 class="product-title">{{ product.title }}</h1>

      <p class="product-meta-item">{{ medium }}</p>
      {%- if dims != blank -%}
        <p class="product-meta-item">{{ dims }}</p>
      {%- endif -%}
      <p class="product-meta-item">Original — signed, with certificate of authenticity</p>

      {%- if product.available -%}
        <p class="product-price">{{ product.price | money }}</p>
        {%- capture email_subject -%}Inquiry — {{ product.title }}{%- endcapture -%}
        {%- capture email_body -%}Hello Natalia,%0D%0A%0D%0AI am interested in acquiring "{{ product.title }}" ({{ product.metafields.custom.dimensions_cm | default: product.metafields.custom.dimensions }}, {{ product.price | money }}).%0D%0A%0D%0ACould you please share availability, payment options and shipping details?%0D%0A%0D%0AThank you.{%- endcapture -%}
        <a href="mailto:poltevskaya.art@gmail.com?subject={{ email_subject | url_encode }}&body={{ email_body }}" class="product-cta">Inquire to Acquire</a>
        <p class="product-cta-note">Opens your email — writes to poltevskaya.art@gmail.com</p>
      {%- else -%}
        <p class="meta-sold" style="margin-top:24px;">SOLD</p>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="product-description" style="margin-top:48px; font-family:'Syne Mono',monospace; font-size:16px; line-height:1.6;">
          {{ product.description }}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>
