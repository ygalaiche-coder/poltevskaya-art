<section class="section" style="margin-top: 64px; text-align: center;">
  <div class="container">
    <h1 class="hero-title" style="margin-bottom: var(--space-6);">Gift Card</h1>
    <p style="color: var(--color-text-muted); margin-bottom: var(--space-6);">
      Here's your {{ shop.name }} gift card.
    </p>
    <div style="margin-bottom: var(--space-8);">
      <p style="font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 400;">
        {{ gift_card.balance | money }}
      </p>
    </div>
    <div style="background: var(--color-surface); padding: var(--space-8); display: inline-block; margin-bottom: var(--space-8);">
      <p style="font-family: monospace; font-size: var(--text-lg); letter-spacing: 0.1em;">
        {{ gift_card.code | format_code }}
      </p>
    </div>
    {%- if gift_card.pass_url -%}
      <p><a href="{{ gift_card.pass_url }}" class="btn">Add to Apple Wallet</a></p>
    {%- endif -%}
    <p style="margin-top: var(--space-8);"><a href="{{ shop.url }}" class="back-link">&larr; Continue Shopping</a></p>
  </div>
</section>
