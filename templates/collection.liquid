<section class="section collection-section" style="margin-top: 64px;">
  <div class="container">
    <div class="divider"></div>

    <header class="collection-header reveal">
      <h1 class="section-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="collection-description">{{ collection.description }}</p>
      {%- endif -%}
      {%- if collection.products_count > 0 -%}
        <p class="collection-count">{{ collection.products_count }} work{% if collection.products_count != 1 %}s{% endif %}</p>
      {%- endif -%}
    </header>

    {%- if collection.products.size > 0 -%}
      <div class="gallery-grid reveal-stagger">
        {%- assign product_list = collection.products -%}
        {%- if collection.handle == 'all' -%}
          {%- comment -%} Curated order: 'frontpage' (manual sort) first, then remaining products {%- endcomment -%}
          {%- assign product_list = collections.frontpage.products | concat: collection.products -%}
        {%- endif -%}
        {%- assign seen_ids = ',' -%}
        {%- for product in product_list -%}
          {%- assign pid_key = ',' | append: product.id | append: ',' -%}
          {%- if seen_ids contains pid_key -%}{%- continue -%}{%- endif -%}
          {%- assign seen_ids = seen_ids | append: product.id | append: ',' -%}
          <a href="{{ product.url }}" class="gallery-item reveal" style="text-decoration: none;" aria-label="{{ product.title }}">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {%- endif -%}

            <div class="overlay">
              <div class="overlay-content">
                <span class="overlay-text">{{ product.title }}</span>
                {%- if product.metafields.custom.dimensions_cm != blank -%}
                  <span class="overlay-size">{{ product.metafields.custom.dimensions_cm }}
                    {%- if product.metafields.custom.dimensions_in != blank -%}
                      · {{ product.metafields.custom.dimensions_in }}
                    {%- endif -%}
                  </span>
                {%- endif -%}
                {%- liquid
                  assign is_available = product.available
                  if settings.hide_prices
                    assign is_available = false
                    if product.tags contains 'inquire-available'
                      assign is_available = true
                    endif
                  endif
                -%}
                {%- unless is_available -%}
                  <span class="overlay-sold">Sold</span>
                {%- endunless -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination">
          {{- paginate | default_pagination -}}
        </div>
      {%- endif -%}

    {%- else -%}
      <p class="collection-empty">No works in this collection yet.</p>
    {%- endif -%}

  </div>
</section>
