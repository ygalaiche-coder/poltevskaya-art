{%- assign collection = collections[section.settings.collection] -%}
{%- if collection == blank -%}
  {%- comment -%} Curated order: 'frontpage' (Home page, manual sort) first, then any other products not yet in it {%- endcomment -%}
  {%- assign collection = collections.all -%}
  {%- assign curated = true -%}
{%- endif -%}
{%- assign seen_ids = ',' -%}
{%- assign shown = 0 -%}

<main class="artworks">
  {%- for pass in (1..2) -%}
  {%- if pass == 1 -%}
    {%- if curated -%}{%- assign product_list = collections.frontpage.products -%}{%- else -%}{%- continue -%}{%- endif -%}
  {%- else -%}
    {%- assign product_list = collection.products -%}
  {%- endif -%}
  {%- for product in product_list -%}
    {%- assign pid_key = ',' | append: product.id | append: ',' -%}
    {%- if seen_ids contains pid_key or shown >= section.settings.limit -%}{%- continue -%}{%- endif -%}
    {%- assign seen_ids = seen_ids | append: product.id | append: ',' -%}
    {%- assign shown = shown | plus: 1 -%}
    {%- assign year = product.metafields.custom.year | default: '2026' -%}
    {%- assign medium = product.metafields.custom.medium | default: 'Acrylic on Canvas' -%}
    {%- assign dims = product.metafields.custom.dimensions_cm | default: product.metafields.custom.dimensions -%}

    {%- comment -%}
      Fallback dimensions by product title, in case the metafield is not yet filled in the Shopify admin.
      Update these values here if the actual painting sizes differ.
    {%- endcomment -%}
    {%- if dims == blank -%}
      {%- assign t = product.title | downcase -%}
      {%- case t -%}
        {%- when '3 gooses' -%}{%- assign dims = '100 × 120 cm' -%}
        {%- when 'blue lover' -%}{%- assign dims = '80 × 120 cm' -%}
        {%- when 'eternity love' -%}{%- assign dims = '120 × 120 cm' -%}
        {%- when 'gentlemen' -%}{%- assign dims = '100 × 120 cm' -%}
        {%- when 'life choice' -%}{%- assign dims = '120 × 120 cm' -%}
        {%- when 'naked silence' -%}{%- assign dims = '120 × 120 cm' -%}
        {%- when 'sirena' -%}{%- assign dims = '200 × 155 cm' -%}
        {%- when 'seven men' -%}{%- assign dims = '120 × 80 cm' -%}
        {%- when 'seven mens' -%}{%- assign dims = '120 × 80 cm' -%}
        {%- when 'st. tropez sunset' -%}{%- assign dims = '120 × 120 cm' -%}
        {%- when 'st tropez sunset' -%}{%- assign dims = '120 × 120 cm' -%}
        {%- when 'the architecture of desire' -%}{%- assign dims = '120 × 120 cm' -%}
        {%- when 'the curled' -%}{%- assign dims = '50 × 70 cm' -%}
        {%- when 'the landlord' -%}{%- assign dims = '150 × 100 cm' -%}
        {%- when 'the last lord' -%}{%- assign dims = '150 × 100 cm' -%}
        {%- when 'the leopard' -%}{%- assign dims = '100 × 100 cm' -%}
        {%- when 'the masked' -%}{%- assign dims = '50 × 70 cm' -%}
        {%- when 'the privilege of being alone' -%}{%- assign dims = '100 × 120 cm' -%}
        {%- when 'the two blue' -%}{%- assign dims = '100 × 100 cm' -%}
        {%- when 'the western' -%}{%- assign dims = '120 × 80 cm' -%}
        {%- when 'world conspiracy' -%}{%- assign dims = '100 × 100 cm' -%}
      {%- endcase -%}
    {%- endif -%}

    <section class="artwork">
      <div class="artwork-meta">
        <p class="meta-year">{{ year }}</p>
        <p class="meta-title">
          "{{ product.title }}," {{ medium }}
        </p>
        {%- if dims != blank -%}
          <p class="meta-dims">{{ dims }}</p>
        {%- endif -%}
        <a href="{{ product.url }}" class="meta-link">View &amp; Inquire →</a>
        {%- liquid
          assign is_available = product.available
          if settings.hide_prices
            assign is_available = false
            if product.tags contains 'inquire-available'
              assign is_available = true
            endif
          endif
        -%}
        {%- unless is_available -%}
          <p class="meta-sold">SOLD</p>
        {%- endunless -%}
      </div>
      <div class="artwork-image">
        <a href="{{ product.url }}">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 1400 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {%- endif -%}
        </a>
      </div>
    </section>
  {%- endfor -%}
  {%- endfor -%}
</main>

{% schema %}
{
  "name": "Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected Works"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products to show",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 30
    }
  ],
  "presets": [
    { "name": "Gallery" }
  ]
}
{% endschema %}
