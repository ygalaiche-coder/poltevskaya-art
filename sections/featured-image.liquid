<section class="featured-strip reveal">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 1600 }}"
      alt="{{ section.settings.image.alt | default: 'Featured image' | escape }}"
      loading="lazy"
      style="max-height: 65vh; width: 100%; object-fit: cover;"
    >
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag }}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Featured Image"
    }
  ]
}
{% endschema %}
