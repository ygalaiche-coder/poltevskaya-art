<section class="about-page">
  <div class="about-inner">
    <h1 class="about-title">{{ section.settings.heading | default: 'About' }}</h1>
    <div class="about-body">
      {{ section.settings.body }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Bio",
      "default": "<p>Natalia Poltevskaya (b. 1985) is a Russian–Portuguese contemporary painter working between Moscow and Lisbon. Her practice centers on the human figure, using acrylic on canvas to explore emotional interiority through bold color, symbolic composition, and refined figuration.</p><p>Her work draws on both Eastern European modernism and Mediterranean light, and has been shown in private collections across Europe and the United States. Each painting is a unique original — signed and accompanied by a certificate of authenticity.</p><p>Studio: Sintra, Portugal.</p>"
    }
  ],
  "presets": [
    { "name": "About" }
  ]
}
{% endschema %}
