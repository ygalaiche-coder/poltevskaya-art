<header class="site-header">
  <a href="{{ routes.root_url }}" class="site-title">{{ shop.name | upcase }} ARTIST</a>
  <nav class="site-nav">
    <a href="{{ routes.root_url }}" class="nav-link {% if template == 'index' %}active{% endif %}">Artworks</a>
    <a href="/pages/about" class="nav-link {% if template contains 'page' and page.handle == 'about' %}active{% endif %}">About</a>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
